# ==========================================
# Utsav Studio - Environment Configuration
# ==========================================

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Admin Authentication)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-api

# Cloudinary (Cloud Media Storage for Admin Template Assets)
# Obtain these from your Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Public Admin Access Security
# Admin emails allowed to authenticate
ADMIN_ALLOWED_EMAILS=admin@utsavstudio.in
